.mx_MClaudeBody {
    background: var(--cpd-color-bg-subtle-secondary);
    border-radius: 8px;
    padding: 12px;
    margin: 4px 0;
    border-left: 3px solid var(--cpd-color-icon-accent-tertiary);
}

.mx_MClaudeBody_fallback {
    white-space: pre-wrap;
    word-break: break-word;
}

.mx_MClaudeBody_thinking,
.mx_MClaudeBody_toolCalls {
    margin-bottom: 12px;
}

.mx_MClaudeBody_toggle {
    background: none;
    border: none;
    color: var(--cpd-color-text-secondary);
    cursor: pointer;
    font-size: 14px;
    padding: 4px 8px;
    display: flex;
    align-items: center;
    gap: 4px;

    &:hover {
        color: var(--cpd-color-text-primary);
    }
}

.mx_MClaudeBody_toggleIcon {
    font-size: 10px;
    width: 14px;
}

.mx_MClaudeBody_thinkingContent {
    background: var(--cpd-color-bg-subtle-primary);
    border-radius: 4px;
    padding: 8px;
    margin-top: 8px;
    font-size: 13px;
    white-space: pre-wrap;
    color: var(--cpd-color-text-secondary);
    max-height: 200px;
    overflow-y: auto;
}

.mx_MClaudeBody_toolCallsList {
    margin-top: 8px;
}

.mx_MClaudeBody_toolCall {
    background: var(--cpd-color-bg-subtle-primary);
    border-radius: 4px;
    padding: 8px;
    margin: 4px 0;
}

.mx_MClaudeBody_toolName {
    color: var(--cpd-color-text-action-accent);
    font-weight: 500;
    font-size: 13px;
}

.mx_MClaudeBody_toolInput {
    font-size: 12px;
    margin-top: 4px;
    background: var(--cpd-color-bg-canvas-default);
    padding: 4px 8px;
    border-radius: 4px;
    overflow-x: auto;
}

.mx_MClaudeBody_toolResult {
    background: var(--cpd-color-bg-canvas-default);
    border-radius: 4px;
    padding: 8px;
    margin: 4px 0;

    pre {
        font-size: 12px;
        white-space: pre-wrap;
        margin: 0;
    }
}

.mx_MClaudeBody_content {
    line-height: 1.6;

    h2,
    h3,
    h4 {
        margin: 8px 0 4px 0;
    }

    p {
        margin: 4px 0;
    }
}

.mx_MClaudeBody_usage {
    margin-top: 8px;
    font-size: 12px;
    color: var(--cpd-color-text-secondary);
    display: flex;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--cpd-color-border-subtle);
}

.mx_MClaudeBody_model {
    background: var(--cpd-color-bg-subtle-primary);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
}
