.mx_AgentsEventViewer {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.mx_AgentsEventViewer_filters {
    display: flex;
    gap: 12px;
    padding: 12px;
    border-bottom: 1px solid var(--cpd-color-border-subtle);
    flex-shrink: 0;
}

.mx_AgentsEventViewer_filterGroup {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;

    label {
        font-size: 12px;
        color: var(--cpd-color-text-secondary);
    }

    select {
        padding: 6px 8px;
        border-radius: 4px;
        border: 1px solid var(--cpd-color-border-subtle);
        background: var(--cpd-color-bg-canvas-default);
        color: var(--cpd-color-text-primary);
        font-size: 13px;
        cursor: pointer;

        &:focus {
            outline: none;
            border-color: var(--cpd-color-border-focused);
        }
    }
}

.mx_AgentsEventViewer_events {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
}

.mx_AgentsEventViewer_loading,
.mx_AgentsEventViewer_empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100px;
    color: var(--cpd-color-text-secondary);
}

.mx_AgentsEventViewer_event {
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--cpd-color-border-subtle);

    &:last-child {
        border-bottom: none;
    }
}

.mx_AgentsEventViewer_eventHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.mx_AgentsEventViewer_sender {
    font-weight: 500;
    color: var(--cpd-color-text-action-accent);
}

.mx_AgentsEventViewer_time {
    font-size: 12px;
    color: var(--cpd-color-text-secondary);
}

.mx_AgentsEventViewer_eventContent {
    /* Content styling handled by child components */
}

.mx_AgentsEventViewer_fallback {
    background: var(--cpd-color-bg-subtle-secondary);
    padding: 8px;
    border-radius: 4px;
    font-size: 13px;
    white-space: pre-wrap;
    margin: 0;
}

.mx_AgentsEventViewer_stats {
    padding: 8px 12px;
    font-size: 12px;
    color: var(--cpd-color-text-secondary);
    border-top: 1px solid var(--cpd-color-border-subtle);
    flex-shrink: 0;
}
